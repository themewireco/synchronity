{
  "name": "synchronity",
  "description": "Shop across connected stores with AI: search, compare, cart, checkout, and pay with human approval.",
  "version": "0.1.0",
  "author": {
    "name": "Synchronity",
    "url": "https://synchronity.app"
  },
  "homepage": "https://synchronity.app",
