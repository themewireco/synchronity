  "license": "MIT",
  "keywords": [
    "synchronity",
    "shopping",
    "commerce",
    "checkout",
    "payments",
    "mcp",
    "agents"
  ],
  "mcpServers": {
    "synchronity": {
      "command": "npx",
      "args": ["-y", "@synchronity/mcp-server"],
      "env": {
        "GATEWAY_URL": "https://api.synchronity.app"
      }
    }
  }
}
