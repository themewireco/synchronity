{
  "name": "@synchronity/mcp-server",
  "version": "0.1.1",
  "mcpName": "io.github.themewireco/synchronity",
  "description": "Synchronity MCP Server - shop across connected e-commerce stores from Claude, ChatGPT, and other MCP clients",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themewireco/synchronity.git"
  },
  "homepage": "https://synchronity.app",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "bin": {
    "synchronity-mcp": "./dist/index.js",
    "agentmesh-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@synchronity/sdk": "file:../typescript",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "ajv": "^8.20.0",
    "jsdom": "^29.1.1",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "synchronity",
    "ecommerce",
    "mcp",
    "claude",
    "ai",
    "agents"
  ],
  "license": "MIT"
}
